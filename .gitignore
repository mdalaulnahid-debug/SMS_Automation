# Personnel Registry source spreadsheet — real officer names/phone/email.
# Kept locally for convenient re-upload via the admin console; never tracked.
data/personnel-registry/*.xlsx
data/personnel-registry/*.xls
data/personnel-registry/~$*
Training Data/Automation/~$*.xlsx
Training Data/Automation/*.tmp

# graphify: keep the queryable index (graph.json, report, manifest); ignore the
# heavy regenerable bits (interactive HTML, rebuild cache, interpreter markers,
# and the timestamped pre-overwrite backup dirs graphify creates on rebuild)
graphify-out/cache/
graphify-out/*.html
graphify-out/.graphify_*
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Local configs/caches for other AI coding tools used on this machine — not
# part of this project, never meant to be tracked.
.agents/
.codex/
.cursor/
.gemini/
.github/hooks/
.github/skills/
.claude/skills/impeccable/
